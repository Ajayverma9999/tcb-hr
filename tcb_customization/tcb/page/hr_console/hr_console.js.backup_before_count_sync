						transition: background .12s ease;
					}

					.hr-console .hr-employee-row.selected {
						background: #f0f4ff !important;
					}

					@media (max-width: 900px) {
						.hr-console .hr-summary-grid {
							grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
						}

						.hr-console .hr-content-grid {
							grid-template-columns: 1fr !important;
						}
					}

					@media (max-width: 550px) {
						.hr-console .hr-summary-grid {
							grid-template-columns: 1fr !important;
						}
					}
				</style>

				<!-- HEADER -->
				<div style="
					display:flex;
					justify-content:space-between;
					align-items:flex-end;
					gap:20px;
					margin-bottom:20px;
					flex-wrap:wrap;
				">

					<div>
						<h2 style="margin:0 0 5px 0;">
							HR Console
						</h2>

					</div>

					<div style="display:flex;gap:10px;flex-wrap:wrap;">
						<div style="min-width:160px;">
							<label style="
								display:block;
								font-size:13px;
								font-weight:600;
								margin-bottom:5px;
							">
								From Date
							</label>
							<input
								type="date"
								id="hr-from-date"
								class="form-control"
								value="${selectedDate}"
							/>
						</div>
						<div style="min-width:160px;">
							<label style="
								display:block;
								font-size:13px;
								font-weight:600;
								margin-bottom:5px;
							">
								To Date
							</label>
							<input
								type="date"
								id="hr-to-date"
								class="form-control"
								value="${selectedDate}"
							/>
						</div>

						<button
							class="btn btn-primary"
							id="hr-refresh"
							style="height:38px;margin-top:24px;"
						>
							Refresh
						</button>

					</div>

				</div>

				<!-- SUMMARY CARDS -->
				<div
					class="hr-summary-grid"
					style="
						display:grid;
						grid-template-columns:repeat(8,minmax(0,1fr));
						gap:16px;
						margin-bottom:20px;
					"
				>

					<div
						class="hr-stat-card active-card"
						data-status="Active"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Active Headcount
						</div>

						<div
							id="hr-headcount"
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<div
						class="hr-stat-card"
						data-status="Present"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Present
						</div>

						<div
							id="hr-present"
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<div
						class="hr-stat-card"
						data-status="Absent"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Absent
						</div>

						<div
							id="hr-absent"
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<div
						class="hr-stat-card"
						data-status="Pending"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Pending Attendance
						</div>

						<div
							id="hr-pending"
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<div
						class="hr-stat-card"
						data-status="On Leave"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							On Leave
						</div>

						<div
							id="hr-leave"
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>
					<div
						class="hr-stat-card hr-action-card"
						id="hr-wfh-apply"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Work From Home
						</div>
						<div
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							" id="hr-wfh-count"
						>
							
						</div>
					</div>
					<div
						class="hr-stat-card hr-action-card"
						id="hr-leave-application"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Leave Application
						</div>
						<div
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							" id="hr-leave-application-count"
						>
							
						</div>
					</div>
					<div
						class="hr-stat-card hr-action-card"
						id="hr-expense-claim"
						style="
							padding:12px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:12px;">
							Expense Claim
						</div>
						<div
							style="
								font-size:22px;
								font-weight:700;
								margin-top:8px;
							" id="hr-expense-claim-count"
						>
							
						</div>
					</div>

				</div>

				<!-- SELECTED STATUS -->

				<!-- CONTENT -->
				<div
					class="hr-content-grid"
					style="
						display:grid;
						grid-template-columns:1fr;
						gap:20px;
						margin-left:20px;
						margin-right:20px;
					"
				>

					<!-- EMPLOYEE LIST -->
					<div style="
						border:1px solid #ddd;
						border-radius:10px;
						background:white;
						padding:15px;
					">

						<h4 style="margin-top:0;">
							Employees
						</h4>

						<div style="
							display:flex;
							gap:8px;
							margin-bottom:12px;
							flex-wrap:wrap;
						">

							<input
								id="hr-search"
								class="form-control"
								placeholder="Search employee..."
								style="flex:1;min-width:150px;"
							/>

							<select
								id="hr-department"
								class="form-control"
								style="min-width:150px;"
							>
								<option value="">
									All Departments
								</option>
							</select>

						</div>

						<div id="hr-employee-list">
							Loading employees...
						</div>

						<div style="
							display:flex;
							justify-content:space-between;
							align-items:center;
							margin-top:15px;
						">

							<button
								class="btn btn-default btn-sm"
								id="hr-prev"
							>
								Previous
							</button>

							<span id="hr-page">
								Page 1
							</span>

							<button
								class="btn btn-default btn-sm"
								id="hr-next"
							>
								Next
							</button>

						</div>

					</div>



				</div>

			</div>
		`);

		// ==================================================
		// REFERENCES
		// ==================================================

		const $list = $main.find("#hr-employee-list");
		const $detail = $main.find("#hr-detail");
		const $search = $main.find("#hr-search");
		const $department = $main.find("#hr-department");
		const $fromDate = $main.find("#hr-from-date");
		const $toDate = $main.find("#hr-to-date");

		loadActionCardCounts();

		// ==================================================
		// STATUS LABEL
		// ==================================================

		function updateStatusLabel() {
			$main
				.find("#hr-selected-status")
				.text(
					`${currentStatus} Employees — ${selectedDate}`
				);
		}

		// ==================================================
		// OVERVIEW
		// ==================================================

		function loadOverview() {

			$main.find("#hr-headcount").text("...");
			$main.find("#hr-present").text("...");
			$main.find("#hr-absent").text("...");
			$main.find("#hr-pending").text("...");
			$main.find("#hr-leave").text("...");

			frappe.call({

				method:
					"tcb_customization.api.hr_console.get_overview",

				args: {
					from_date: fromDate,
					to_date: toDate,
				},

				callback(r) {

					const data = r.message || {};

					$main
						.find("#hr-headcount")
						.text(data.headcount ?? 0);

					$main
						.find("#hr-present")
						.text(data.present ?? 0);

					$main
						.find("#hr-absent")
						.text(data.absent ?? 0);

					$main
						.find("#hr-pending")
						.text(data.pending ?? 0);

					$main
						.find("#hr-leave")
						.text(data.on_leave ?? 0);
				},

				error(err) {

					console.error(
						"HR Console overview error",
						err
					);

					$main.find("#hr-headcount").text("—");
					$main.find("#hr-present").text("—");
					$main.find("#hr-absent").text("—");
					$main.find("#hr-pending").text("—");
					$main.find("#hr-leave").text("—");
				},
			});
		}

		// ==================================================
		// ACTION CARD COUNTS
		// ==================================================

		function loadActionCardCounts() {
			const from_date = $fromDate.val();
			const to_date = $toDate.val();

			if (!from_date || !to_date) {
				return;
			}

			$main.find("#hr-wfh-count").text("...");
			$main.find("#hr-leave-application-count").text("...");
			$main.find("#hr-expense-claim-count").text("...");

			frappe.db.count("Attendance Request", {
				filters: [
					["Attendance Request", "reason", "=", "Work From Home"],
					["Attendance Request", "from_date", "<=", to_date],
					["Attendance Request", "to_date", ">=", from_date]
				]
			}).then((count) => {
				$main.find("#hr-wfh-count").text(count || 0);
			});

			frappe.db.count("Leave Application", {
				filters: [
					["Leave Application", "from_date", "<=", to_date],
					["Leave Application", "to_date", ">=", from_date]
				]
			}).then((count) => {
				$main.find("#hr-leave-application-count").text(count || 0);
			});

			frappe.db.count("Expense Claim", {
				filters: [
					["Expense Claim", "posting_date", ">=", from_date],
					["Expense Claim", "posting_date", "<=", to_date]
				]
			}).then((count) => {
				$main.find("#hr-expense-claim-count").text(count || 0);
			});
		}

		// ==================================================
		// DEPARTMENTS
		// ==================================================

		function loadDepartments() {

			frappe.call({

				method:
					"tcb_customization.api.hr_console.get_departments",

				callback(r) {

					const departments =
						r.message || [];

					$department
						.find("option:not(:first)")
						.remove();

					departments.forEach(
						(department) => {

							const safe =
								frappe.utils.escape_html(
									department
								);

							$department.append(`
								<option value="${safe}">
									${safe}
								</option>
							`);
						}
					);
				},
			});
		}

		// ==================================================
		// EMPLOYEE LIST
		// ==================================================

		function loadEmployees(pageNumber = 0) {

			currentPage = Math.max(
				0,
				pageNumber
			);

			const start =
				currentPage * pageSize;

			$list.html(`
				<div style="
					padding:25px;
					text-align:center;
					color:#888;
				">
					Loading ${frappe.utils.escape_html(
						currentStatus
					).toLowerCase()} employees...
				</div>
			`);

			frappe.call({

				method:
					"tcb_customization.api.hr_console.get_attendance_employees",

				args: {

					from_date:
						fromDate,
					to_date:
						toDate,

					status:
						currentStatus,

					start:
						start,

					limit:
						pageSize,

					search:
						$search.val() || "",

					department:
						$department.val() || "",
				},

				callback(r) {

					const employees =
						r.message || [];

					$list.empty();

					if (!employees.length) {

						$list.html(`
							<div style="
								padding:30px 15px;
								color:#888;
								text-align:center;
							">

								<div style="
									font-size:28px;
									margin-bottom:8px;
								">
									No employees
								</div>

								<div>
									No ${frappe.utils.escape_html(
										currentStatus
									).toLowerCase()}
									employees found for
									${frappe.utils.escape_html(
										selectedDate
									)}.
								</div>

							</div>
						`);

						updatePagination(
							employees.length
						);

						return;
					}

					employees.forEach(
						(employee) => {

							const name =
								frappe.utils.escape_html(
									employee.employee_name || ""
								);

							const employeeId =
								frappe.utils.escape_html(
									employee.name || ""
								);

							const designation =
								frappe.utils.escape_html(
									employee.designation || ""
								);

							const department =
								frappe.utils.escape_html(
									employee.department || ""
								);

							const status =
								frappe.utils.escape_html(
									employee.attendance_status || ""
								);

							const statusClass =
								status === "Present"
									? "green"
									: status === "Absent"
										? "red"
										: status === "On Leave"
											? "orange"
											: status === "Pending"
												? "blue"
												: "gray";

							const isSelected =
								selectedEmployee ===
								employee.name;

							const $row = $(`
								<div
									class="
										hr-employee-row
										${isSelected ? "selected" : ""}
									"
									style="
										padding:13px;
										border-bottom:1px solid #eee;
										cursor:pointer;
										border-radius:6px;
									"
								>

									<div style="
										display:flex;
										justify-content:space-between;
										gap:8px;
										align-items:flex-start;
									">

										<div style="
											font-weight:600;
										">
											${name}
										</div>

										<div style="
											font-size:11px;
											font-weight:600;
											padding:3px 7px;
											border-radius:10px;
											background:#f3f4f6;
										">
											${status}
										</div>

									</div>

									<div style="
										font-size:12px;
										color:#888;
										margin-top:4px;
									">
										${designation}
										${
											designation &&
											department
												? " • "
												: ""
										}
										${department}
									</div>

									<div style="
										font-size:11px;
										color:#999;
										margin-top:5px;
									">
										${employeeId}
									</div>

								</div>
							`);

							$row.on(
								"click",
								function () {

									selectedEmployee =
										employee.name;

									$list
										.find(".hr-employee-row")
										.removeClass(
											"selected"
										);

									$row.addClass(
										"selected"
									);

									loadEmployeeDetail(
										employee.name,
										employee.employee_name
									);
								}
							);

							$row.on(
								"mouseenter",
								function () {

									if (
										selectedEmployee !==
										employee.name
									) {
										$(this).css(
											"background",
											"#f7f7f7"
										);
									}
								}
							);

							$row.on(
								"mouseleave",
								function () {

									if (
										selectedEmployee !==
										employee.name
									) {
										$(this).css(
											"background",
											"white"
										);
									}
								}
							);

							$list.append($row);
						}
					);

					updatePagination(
						employees.length
					);
				},

				error(err) {

					console.error(
						"Employee list error",
						err
					);

					$list.html(`
						<div style="
							padding:12px;
							color:#b91c1c;
						">
							Failed to load employees.
						</div>
					`);

					updatePagination(0);
				},
			});
		}

		// ==================================================
		// PAGINATION
		// ==================================================

		function updatePagination(resultLength) {

			$main
				.find("#hr-page")
				.text(
					`Page ${currentPage + 1}`
				);

			$main
				.find("#hr-prev")
				.prop(
					"disabled",
					currentPage === 0
				);

			$main
				.find("#hr-next")
				.prop(
					"disabled",
					resultLength < pageSize
				);
		}

		// ==================================================
		// EMPLOYEE DETAIL
		// ==================================================

		function loadEmployeeDetail(
			employee,
			employeeName
		) {

			$detail.html(`
				<div style="
					padding:30px;
					text-align:center;
					color:#888;
				">
					Loading employee details...
				</div>
			`);

			const selected =
				frappe.datetime.str_to_obj(
					selectedDate
				);

			const from =
				new Date(
					selected.getFullYear(),
					selected.getMonth(),
					1
				);

			const to =
				new Date(
					selected.getFullYear(),
					selected.getMonth() + 1,
					0
				);

			const fromDate =
				frappe.datetime.obj_to_str(from);

			const toDate =
				frappe.datetime.obj_to_str(to);

			frappe.call({

				method:
					"tcb_customization.api.hr_console.get_employee_detail",

				args: {

					employee:
						employee,

					from_date:
						fromDate,

					to_date:
						toDate,
				},

				callback(r) {

					const data =
						r.message || {};

					const employeeInfo =
						data.employee || {};

					const attendance =
						data.attendance || [];

					const salarySlips =
						data.salary_slips || [];

					const attendanceMap = {};

					attendance.forEach(
						(row) => {

							attendanceMap[
								row.attendance_date
							] = row;

						}
					);

					const selectedAttendance =
						attendanceMap[selectedDate];

					const selectedStatus =
						selectedAttendance?.status ||
						"Pending";

					let html = `

						<!-- PROFILE -->

						<div style="
							display:flex;
							justify-content:space-between;
							align-items:flex-start;
							gap:15px;
							flex-wrap:wrap;
						">

							<div>

								<h3 style="
									margin-top:0;
									margin-bottom:5px;
								">
									${frappe.utils.escape_html(
										employeeInfo.employee_name ||
										employeeName ||
										""
									)}
								</h3>

								<div style="
									color:#888;
									font-size:13px;
								">
									${frappe.utils.escape_html(
										employeeInfo.name ||
										employee
									)}
								</div>

							</div>

