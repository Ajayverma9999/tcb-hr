frappe.pages["hr-console"] = frappe.pages["hr-console"] || {};

Object.assign(frappe.pages["hr-console"], {
	on_page_load(wrapper) {
		const page = frappe.ui.make_app_page({
			parent: wrapper,
			title: "HR Console",
			single_column: true,
		});

		const $main = $(page.main);

		// --------------------------------------------------
		// State
		// --------------------------------------------------

		let currentPage = 0;
		let currentStatus = "Active";
		let selectedDate = frappe.datetime.get_today();
		const pageSize = 50;

		// --------------------------------------------------
		// HTML
		// --------------------------------------------------

		$main.html(`
			<div class="hr-console" style="padding:20px;">

				<!-- Header -->
				<div style="
					display:flex;
					justify-content:space-between;
					align-items:flex-end;
					gap:20px;
					margin-bottom:20px;
					flex-wrap:wrap;
				">

					<div>
						<h2 style="margin:0 0 5px 0;">
							HR Console
						</h2>

						<div style="color:#888;">
							HR management dashboard
						</div>
					</div>

					<div style="min-width:200px;">
						<label style="
							display:block;
							font-size:13px;
							font-weight:600;
							margin-bottom:5px;
						">
							Attendance Date
						</label>

						<input
							type="date"
							id="hr-attendance-date"
							class="form-control"
							value="${selectedDate}"
						/>
					</div>

				</div>

				<!-- Attendance Summary -->
				<div style="
					display:grid;
					grid-template-columns:repeat(5, minmax(0, 1fr));
					gap:16px;
					margin-bottom:20px;
				">

					<!-- Active -->
					<div
						class="hr-stat-card"
						data-status="Active"
						style="
							padding:20px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:13px;">
							Active Headcount
						</div>

						<div
							id="hr-headcount"
							style="
								font-size:30px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<!-- Present -->
					<div
						class="hr-stat-card"
						data-status="Present"
						style="
							padding:20px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:13px;">
							Present
						</div>

						<div
							id="hr-present"
							style="
								font-size:30px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<!-- Absent -->
					<div
						class="hr-stat-card"
						data-status="Absent"
						style="
							padding:20px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:13px;">
							Absent
						</div>

						<div
							id="hr-absent"
							style="
								font-size:30px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<!-- Pending -->
					<div
						class="hr-stat-card"
						data-status="Pending"
						style="
							padding:20px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:13px;">
							Pending Attendance
						</div>

						<div
							id="hr-pending"
							style="
								font-size:30px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

					<!-- Leave -->
					<div
						class="hr-stat-card"
						data-status="On Leave"
						style="
							padding:20px;
							border:1px solid #ddd;
							border-radius:10px;
							background:white;
							cursor:pointer;
						"
					>
						<div style="color:#888;font-size:13px;">
							On Leave
						</div>

						<div
							id="hr-leave"
							style="
								font-size:30px;
								font-weight:700;
								margin-top:8px;
							"
						>
							—
						</div>
					</div>

				</div>

				<!-- Selected Status -->
				<div
					id="hr-selected-status"
					style="
						margin-bottom:15px;
						font-weight:600;
						color:#555;
					"
				>
					Active Employees
				</div>

				<!-- Actions -->
				<div style="
					display:flex;
					gap:10px;
					margin-bottom:20px;
					flex-wrap:wrap;
				">

					<button
						class="btn btn-primary"
						id="hr-refresh"
					>
						Refresh
					</button>

					<button
						class="btn btn-warning"
						id="hr-review"
					>
						Open Attendance Review Queue
					</button>

				</div>

				<!-- Employee Section -->
				<div style="
					display:grid;
					grid-template-columns:35% 65%;
					gap:20px;
				">

					<!-- Left -->
					<div style="
						border:1px solid #ddd;
						border-radius:10px;
						background:white;
						padding:15px;
					">

						<h4 style="margin-top:0;">
							Employees
						</h4>

						<div style="
							display:flex;
							gap:8px;
							margin-bottom:12px;
						">

							<input
								id="hr-search"
								class="form-control"
								placeholder="Search employee..."
							/>

							<select
								id="hr-department"
								class="form-control"
								style="min-width:150px;"
							>
								<option value="">
									All Departments
								</option>
							</select>

						</div>

						<div id="hr-employee-list">
							Loading employees...
						</div>

						<div style="
							display:flex;
							justify-content:space-between;
							margin-top:15px;
						">

							<button
								class="btn btn-default btn-sm"
								id="hr-prev"
							>
								Previous
							</button>

							<span id="hr-page">
								Page 1
							</span>

							<button
								class="btn btn-default btn-sm"
								id="hr-next"
							>
								Next
							</button>

						</div>

					</div>

					<!-- Right -->
					<div style="
						border:1px solid #ddd;
						border-radius:10px;
						background:white;
						padding:20px;
						min-height:400px;
					">

						<div id="hr-detail">

							<h4>
								Employee Details
							</h4>

							<p style="color:#888;">
								Select an employee from the list.
							</p>

						</div>

					</div>

				</div>

			</div>
		`);

		// --------------------------------------------------
		// References
		// --------------------------------------------------

		const $list =
			$main.find("#hr-employee-list");

		const $detail =
			$main.find("#hr-detail");

		const $search =
			$main.find("#hr-search");

		const $department =
			$main.find("#hr-department");

		const $date =
			$main.find("#hr-attendance-date");

		// --------------------------------------------------
		// Overview
		// --------------------------------------------------

		function loadOverview() {
			frappe.call({
				method:
					"tcb_customization.api.hr_console.get_overview",

				args: {
					attendance_date: selectedDate,
				},

				callback(r) {
					const data = r.message || {};

					$main
						.find("#hr-headcount")
						.text(
							data.headcount ?? "—"
						);

					$main
						.find("#hr-present")
						.text(
							data.present ?? "—"
						);

					$main
						.find("#hr-absent")
						.text(
							data.absent ?? "—"
						);

					$main
						.find("#hr-pending")
						.text(
							data.pending ?? "—"
						);

					$main
						.find("#hr-leave")
						.text(
							data.on_leave ?? "—"
						);
				},

				error(err) {
					console.error(
						"HR Console overview error",
						err
					);
				},
			});
		}

		// --------------------------------------------------
		// Departments
		// --------------------------------------------------

		function loadDepartments() {
			frappe.call({
				method:
					"tcb_customization.api.hr_console.get_departments",

				callback(r) {
					const departments =
						r.message || [];

					$department
						.find("option:not(:first)")
						.remove();

					departments.forEach(
						(department) => {

							$department.append(`
								<option
									value="${frappe.utils.escape_html(
										department
									)}"
								>
									${frappe.utils.escape_html(
										department
									)}
								</option>
							`);

						}
					);
				},
			});
		}

		// --------------------------------------------------
		// Employee List
		// --------------------------------------------------

		function loadEmployees(pageNumber = 0) {

			currentPage = pageNumber;

			const start =
				currentPage * pageSize;

			$list.html(`
				<div style="
					padding:20px;
					text-align:center;
					color:#888;
				">
					Loading employees...
				</div>
			`);

			let method =
				"tcb_customization.api.hr_console.get_attendance_employees";

			let args = {
				attendance_date: selectedDate,
				status: currentStatus,
				start: start,
				limit: pageSize,
				search: $search.val() || "",
				department:
					$department.val() || "",
			};

			frappe.call({
				method: method,
				args: args,

				callback(r) {

					const employees =
						r.message || [];

					$list.empty();

					if (!employees.length) {

						$list.html(`
							<div style="
								padding:20px;
								color:#888;
								text-align:center;
							">
								No employees found.
							</div>
						`);

						$main
							.find("#hr-page")
							.text(
								`Page ${currentPage + 1}`
							);

						return;
					}

					employees.forEach(
						(employee) => {

							const name =
								frappe.utils.escape_html(
									employee.employee_name || ""
								);

							const designation =
								frappe.utils.escape_html(
									employee.designation || ""
								);

							const department =
								frappe.utils.escape_html(
									employee.department || ""
								);

							const status =
								frappe.utils.escape_html(
									employee.attendance_status || ""
								);

							const $row = $(`
								<div
									class="hr-employee-row"
									style="
										padding:12px;
										border-bottom:1px solid #eee;
										cursor:pointer;
									"
								>

									<div style="
										font-weight:600;
									">
										${name}
									</div>

									<div style="
										font-size:12px;
										color:#888;
										margin-top:3px;
									">
										${designation}
										${
											designation &&
											department
												? " • "
												: ""
										}
										${department}
									</div>

									<div style="
										font-size:12px;
										margin-top:5px;
										font-weight:600;
									">
										Status: ${status}
									</div>

								</div>
							`);

							$row.on(
								"click",
								function () {

									loadEmployeeDetail(
										employee.name,
										employee.employee_name
									);

								}
							);

							$row.on(
								"mouseenter",
								function () {
									$(this).css(
										"background",
										"#f7f7f7"
									);
								}
							);

							$row.on(
								"mouseleave",
								function () {
									$(this).css(
										"background",
										"white"
									);
								}
							);

							$list.append($row);
						}
					);

					$main
						.find("#hr-page")
						.text(
							`Page ${currentPage + 1}`
						);
				},

				error(err) {
					console.error(
						"Employee list error",
						err
					);

					$list.html(`
						<div style="
							padding:20px;
							color:red;
						">
							Failed to load employees.
						</div>
					`);
				},
			});
		}

		// --------------------------------------------------
		// Employee Detail
		// --------------------------------------------------

		function loadEmployeeDetail(
			employee,
			employeeName
		) {

			$detail.html(`
				<div style="
					padding:20px;
					color:#888;
				">
					Loading employee details...
				</div>
			`);

			const selected =
				frappe.datetime.str_to_obj(
					selectedDate
				);

			const from =
				new Date(
					selected.getFullYear(),
					selected.getMonth(),
					1
				);

			const to =
				new Date(
					selected.getFullYear(),
					selected.getMonth() + 1,
					0
				);

			const fromDate =
				frappe.datetime.obj_to_str(
					from
				);

			const toDate =
				frappe.datetime.obj_to_str(
					to
				);

			frappe.call({
				method:
					"tcb_customization.api.hr_console.get_employee_detail",

				args: {
					employee: employee,
					from_date: fromDate,
					to_date: toDate,
				},

				callback(r) {

					const data =
						r.message || {};

					const attendance =
						data.attendance || [];

					const salarySlips =
						data.salary_slips || [];

					let html = `
						<h3 style="margin-top:0;">
							${frappe.utils.escape_html(
								employeeName
							)}
						</h3>

						<div style="
							color:#888;
							font-size:13px;
							margin-bottom:10px;
						">
							Selected date:
							${selectedDate}
						</div>

						<hr>

						<h4>Attendance</h4>

						<div style="
							max-height:300px;
							overflow:auto;
						">

							<table class="table table-bordered">

								<thead>
									<tr>
										<th>Date</th>
										<th>Status</th>
									</tr>
								</thead>

								<tbody>
					`;

					const attendanceMap = {};

					attendance.forEach(
						(row) => {

							attendanceMap[
								row.attendance_date
							] = row.status;

						}
					);

					let date =
						new Date(from);

					while (date <= to) {

						const dateString =
							frappe.datetime.obj_to_str(
								date
							);

						const status =
							attendanceMap[
								dateString
							] || "Pending";

						html += `
							<tr>
								<td>
									${dateString}
								</td>

								<td>
									${frappe.utils.escape_html(
										status
									)}
								</td>
							</tr>
						`;

						date.setDate(
							date.getDate() + 1
						);
					}

					html += `
								</tbody>

							</table>

						</div>

						<hr>

						<h4>Pay Summary</h4>
					`;

					if (!salarySlips.length) {

						html += `
							<div style="
								padding:15px;
								color:#888;
								border:1px solid #eee;
								border-radius:8px;
							">
								No salary slips found.
								Payroll not yet run.
							</div>
						`;

					} else {

						salarySlips.forEach(
							(slip) => {

								html += `
									<div style="
										border:1px solid #ddd;
										border-radius:10px;
										padding:15px;
										margin-bottom:15px;
									">

										<div style="
											display:grid;
											grid-template-columns:
												repeat(
													2,
													minmax(0,1fr)
												);
											gap:12px;
										">

											<div>
												<strong>
													Salary Slip
												</strong>
												<br>
												${frappe.utils.escape_html(
													slip.name || ""
												)}
											</div>

											<div>
												<strong>
													Period
												</strong>
												<br>
												${slip.start_date || ""}
												→
												${slip.end_date || ""}
											</div>

											<div>
												<strong>
													Working Days
												</strong>
												<br>
												${slip.total_working_days ?? 0}
											</div>

											<div>
												<strong>
													Payment Days
												</strong>
												<br>
												${slip.payment_days ?? 0}
											</div>

											<div>
												<strong>
													Loss of Pay
												</strong>
												<br>
												${slip.leave_without_pay ?? 0}
											</div>

											<div>
												<strong>
													Absent Days
												</strong>
												<br>
												${slip.absent_days ?? 0}
											</div>

											<div>
												<strong>
													Gross Pay
												</strong>
												<br>
												${slip.gross_pay ?? 0}
											</div>

											<div>
												<strong>
													Total Deduction
												</strong>
												<br>
												${slip.total_deduction ?? 0}
											</div>

											<div>
												<strong>
													Net Pay
												</strong>
												<br>
												${slip.net_pay ?? 0}
											</div>

										</div>

									</div>
								`;

							}
						);

					}

					$detail.html(html);
				},
			});
		}

		// --------------------------------------------------
		// Attendance Review Queue
		// --------------------------------------------------

		function openReviewQueue() {

			const dialog =
				new frappe.ui.Dialog({

					title:
						"Attendance Review Queue",

					fields: [

						{
							fieldname:
								"from_date",

							fieldtype:
								"Date",

							label:
								"From Date",
						},

						{
							fieldname:
								"to_date",

							fieldtype:
								"Date",

							label:
								"To Date",
						},

						{
							fieldname:
								"action",

							fieldtype:
								"Select",

							label:
								"Action",

							options: [
								"accept",
								"reject",
							],

							default:
								"accept",
						},

						{
							fieldname:
								"reason",

							fieldtype:
								"Small Text",

							label:
								"Reason",
						},

						{
							fieldname:
								"rows_html",

							fieldtype:
								"HTML",
						},

					],

					primary_action_label:
						"Process",

					primary_action(values) {

						const selected = [];

						dialog.$wrapper
							.find(
								"input.hr-review-checkbox:checked"
							)
							.each(
								function () {

									const index =
										$(this).data(
											"index"
										);

									selected.push(
										dialog._reviewRows[
											index
										]
									);

								}
							);

						if (!selected.length) {

							frappe.msgprint(
								"Select at least one attendance record."
							);

							return;
						}

						if (
							values.action === "reject" &&
							!values.reason
						) {

							frappe.msgprint(
								"Reason is required when rejecting."
							);

							return;
						}

						const payload =
							selected.map(
								(row) => ({

									employee:
										row.employee,

									date:
										row.date,

									action:
										values.action,

									reason:
										values.reason || "",

								})
							);

						frappe.call({

							method:
								"tcb_customization.api.hr_console.bulk_review",

							args: {

								data:
									JSON.stringify({
										rows:
											payload,
									}),

							},

							callback() {

								frappe.msgprint(
									"Attendance review processed."
								);

								dialog.hide();

								loadOverview();

								loadEmployees(
									currentPage
								);

							},

						});

					},

				});

			dialog._reviewRows = [];

			const reviewDate =
				frappe.datetime.add_days(
					selectedDate,
					-1
				);

			dialog.set_value(
				"from_date",
				reviewDate
			);

			dialog.set_value(
				"to_date",
				reviewDate
			);

			dialog.show();

			function loadReviews() {

				frappe.call({

					method:
						"tcb_customization.api.hr_console.get_pending_reviews",

					args: {

						from_date:
							dialog.get_value(
								"from_date"
							),

						to_date:
							dialog.get_value(
								"to_date"
							),

					},

					callback(r) {

						const rows =
							r.message || [];

						dialog._reviewRows =
							rows;

						let html = "";

						if (!rows.length) {

							html = `
								<div style="
									padding:20px;
									color:#888;
								">
									No pending attendance reviews.
								</div>
							`;

						} else {

							html = `
								<table class="table table-bordered">

									<thead>

										<tr>

											<th>
												<input
													type="checkbox"
													id="hr-select-all"
												>
											</th>

											<th>
												Employee
											</th>

											<th>
												Date
											</th>

											<th>
												Company
											</th>

										</tr>

									</thead>

									<tbody>
							`;

							rows.forEach(
								(row, index) => {

									html += `
										<tr>

											<td>
												<input
													type="checkbox"
													class="hr-review-checkbox"
													data-index="${index}"
												>
											</td>

											<td>
												${frappe.utils.escape_html(
													row.employee_name || ""
												)}
											</td>

											<td>
												${row.date || ""}
											</td>

											<td>
												${frappe.utils.escape_html(
													row.company || ""
												)}
											</td>

										</tr>
									`;

								}
							);

							html += `
									</tbody>

								</table>
							`;
						}

						dialog
							.get_field(
								"rows_html"
							)
							.$wrapper
							.html(html);

						dialog.$wrapper
							.find("#hr-select-all")
							.on(
								"change",
								function () {

									dialog.$wrapper
										.find(
											".hr-review-checkbox"
										)
										.prop(
											"checked",
											$(this).is(
												":checked"
											)
										);

								}
							);

					},

				});

			}

			dialog
				.get_field("from_date")
				.$input
				.on(
					"change",
					loadReviews
				);

			dialog
				.get_field("to_date")
				.$input
				.on(
					"change",
					loadReviews
				);

			loadReviews();
		}

		// --------------------------------------------------
		// Card Click
		// --------------------------------------------------

		$main
			.find(".hr-stat-card")
			.on(
				"click",
				function () {

					currentStatus =
						$(this).data(
							"status"
						);

					currentPage = 0;

					$main
						.find(
							"#hr-selected-status"
						)
						.text(
							`${currentStatus} Employees — ${selectedDate}`
						);

					loadEmployees(0);

				}
			);

		// --------------------------------------------------
		// Date Change
		// --------------------------------------------------

		$date.on(
			"change",
			function () {

				selectedDate =
					$(this).val() ||
					frappe.datetime.get_today();

				currentPage = 0;

				$main
					.find(
						"#hr-selected-status"
					)
					.text(
						`${currentStatus} Employees — ${selectedDate}`
					);

				loadOverview();

				loadEmployees(0);

			}
		);

		// --------------------------------------------------
		// Refresh
		// --------------------------------------------------

		$main
			.find("#hr-refresh")
			.on(
				"click",
				function () {

					loadOverview();

					loadDepartments();

					loadEmployees(
						currentPage
					);

				}
			);

		// --------------------------------------------------
		// Review
		// --------------------------------------------------

		$main
			.find("#hr-review")
			.on(
				"click",
				openReviewQueue
			);

		// --------------------------------------------------
		// Pagination
		// --------------------------------------------------

		$main
			.find("#hr-prev")
			.on(
				"click",
				function () {

					if (
						currentPage > 0
					) {

						loadEmployees(
							currentPage - 1
						);

					}

				}
			);

		$main
			.find("#hr-next")
			.on(
				"click",
				function () {

					loadEmployees(
						currentPage + 1
					);

				}
			);

		// --------------------------------------------------
		// Search
		// --------------------------------------------------

		let searchTimer;

		$search.on(
			"input",
			function () {

				clearTimeout(
					searchTimer
				);

				searchTimer =
					setTimeout(
						function () {

							loadEmployees(0);

						},
						400
					);

			}
		);

		// --------------------------------------------------
		// Department
		// --------------------------------------------------

		$department.on(
			"change",
			function () {

				loadEmployees(0);

			}
		);

		// --------------------------------------------------
		// Initial Load
		// --------------------------------------------------

		loadOverview();

		loadDepartments();

		loadEmployees(0);
	},
});
